generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  OPERATIONS
  FINANCE
  ADMIN
}
enum MembershipRole {
  OWNER
  ADMIN
  PROJECT_MANAGER
  MEMBER
}
enum AccountContext {
  BUSINESS
  SPECIALIST
  CREATOR
}
enum ProjectStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  MATCHING
  ACTIVE
  COMPLETED
  CANCELLED
}
enum ProjectPath {
  INDIVIDUAL
  TEAM
}
enum WorkstreamStatus {
  PROPOSED
  APPROVED
  REJECTED
  STAFFING
  ACTIVE
  COMPLETED
}
enum EngagementStatus {
  INVITED
  PROPOSED
  NEGOTIATING
  AGREED
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}
enum ProposalStatus {
  DRAFT
  OPEN
  COUNTERED
  ACCEPTED
  DECLINED
  WITHDRAWN
  SUPERSEDED
  EXPIRED
}
enum AgreementStatus {
  DRAFT
  PENDING_ACCEPTANCE
  ACTIVE
  SUPERSEDED
  COMPLETED
  CANCELLED
}
enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  APPROVED
  DISPUTED
}
enum VerificationStatus {
  NOT_STARTED
  IN_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}
enum VerificationDimension {
  IDENTITY
  PORTFOLIO_SKILLS
  LOCAL_EXPERTISE
}
enum TrustReviewStatus {
  NOT_STARTED
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  SUBMITTED
  APPROVED
  CANCELLED
}
enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum DisputeStatus {
  OPEN
  AWAITING_EVIDENCE
  UNDER_REVIEW
  AWAITING_RESPONSE
  RESOLVED
  ESCALATED
  CLOSED
}
enum ChangeRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}
enum CampaignStatus {
  DRAFT
  INVITING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}
enum CompensationStatus {
  PENDING
  SIMULATED_PAID
  PROVIDER_CONFIRMED_PAID
  FAILED
  REFUNDED
  DISPUTED
}
enum CampaignCreatorStatus {
  INVITED
  ACCEPTED
  DECLINED
  ACTIVE
  COMPLETED
  CANCELLED
}
enum CampaignContentStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
}
enum CampaignAttributionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  platformRole    PlatformRole @default(USER)
  disabledAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     OrganisationMembership[]
  specialist      ProfessionalProfile?
  creator         CreatorProfile?
  projectsCreated Project[]    @relation("ProjectCreator")
  auditEvents     AuditLog[]   @relation("AuditActor")
  notifications   Notification[]
  proposals       Proposal[]
  engagementsCreated Engagement[] @relation("EngagementCreator")
  messages        ProjectMessage[]
  submissions     Submission[]
  milestoneEvents MilestoneEvent[]
  disputesOpened  Dispute[]       @relation("DisputeOpener")
  changesCreated  ChangeRequest[] @relation("ChangeRequestAuthor")
  trustReviews    TrustReview[]   @relation("TrustReviewer")
  agreementsBuyerAccepted Agreement[] @relation("AgreementBuyerAcceptance")
  agreementsTalentAccepted Agreement[] @relation("AgreementTalentAcceptance")
  shortlistsCreated TalentShortlist[] @relation("ShortlistCreator")
  projectReviews ProjectReview[]
  campaignsCreated Campaign[]
  paymentObligationsCreated CompensationObligation[] @relation("ObligationCreator")
  paymentObligationsReceived CompensationObligation[] @relation("ObligationRecipient")
}

model Organisation {
  id          String   @id @default(cuid())
  name        String
  website     String?
  industry    String?
  model       String?
  product     String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships OrganisationMembership[]
  projects    Project[]
  invitations OrganisationInvitation[]
  campaigns   Campaign[]
}

model OrganisationInvitation {
  id              String         @id @default(cuid())
  organisationId  String
  email           String
  role            MembershipRole @default(MEMBER)
  canApproveSpend Boolean        @default(false)
  token           String         @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime       @default(now())
  organisation    Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  @@index([organisationId, email, acceptedAt])
}

model OrganisationMembership {
  id             String         @id @default(cuid())
  organisationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  canApproveSpend Boolean       @default(false)
  createdAt      DateTime       @default(now())
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organisationId, userId])
  @@index([userId, role])
}

model ProfessionalProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  headline           String?
  biography          String?
  country            String             @default("Nigeria")
  city               String?
  languages          String[]
  categories         String[]
  skills             String[]
  availability       String?
  availabilityStatus String             @default("UNSET")
  availableFrom      DateTime?
  preferredDuration  String?
  preferredArrangement String?
  preferredEngagements String[]          @default([])
  indicativeRate     Int?
  yearsExperience    Int?
  marketExperience   String?
  onboardingCompletedAt DateTime?
  currency           String             @default("NGN")
  verificationStatus VerificationStatus @default(NOT_STARTED)
  isPublished        Boolean            @default(false)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio          PortfolioItem[]
  engagements        Engagement[]
  shortlists         TalentShortlist[]
  tasks              ProjectTask[]
  milestones         Milestone[]
  trustReviews       TrustReview[]
  assessments        SkillsAssessment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CreatorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  biography          String?
  country            String             @default("Nigeria")
  platforms          String[]
  contentCategories  String[]
  audienceEvidence   String?
  audienceSize       Int?
  audienceGeography  String?
  onboardingCompletedAt DateTime?
  verificationStatus VerificationStatus @default(NOT_STARTED)
  isPublished        Boolean            @default(false)
  trustReviews       TrustReview[]
  campaigns          CampaignCreator[]
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model PortfolioItem {
  id          String              @id @default(cuid())
  profileId   String
  title       String
  description String?
  category    String?
  occurredAt  DateTime?
  url         String?
  contribution String?
  skills      String[]            @default([])
  isPublic    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  profile     ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id             String       @id @default(cuid())
  organisationId String
  createdById    String
  title          String
  path           ProjectPath?
  status         ProjectStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("ProjectCreator", fields: [createdById], references: [id])
  brief          ProjectBrief?
  workstreams    Workstream[]
  engagements    Engagement[]
  milestones     Milestone[]
  tasks          ProjectTask[]
  messages       ProjectMessage[]
  shortlists     TalentShortlist[]
  changeRequests ChangeRequest[]
  disputes       Dispute[]
  reviews        ProjectReview[]
  compensationObligations CompensationObligation[]
  @@index([organisationId, status, updatedAt])
}

model ProjectBrief {
  id                    String   @id @default(cuid())
  projectId             String   @unique
  objective             String
  targetMarket          String   @default("Nigeria")
  targetAudience        String?
  currentPresence       String?
  currentCapabilities   String?
  previousAttempts     String?
  budgetMin             Int?
  budgetMax             Int?
  currency              String   @default("NGN")
  deadline              DateTime?
  constraints           String?
  expectedOutcomes      String?
  existingResources    String?
  additionalInformation String?
  scopeQuestions        String[] @default([])
  scopeAssumptions      String[] @default([])
  scopeGeneratedBy      String   @default("RULES_V1")
  scopePromptVersion    String?
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedAt             DateTime @updatedAt
}

model Workstream {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String
  capabilities String[]
  recommendedRoles String[] @default([])
  deliverables  String[] @default([])
  dependencies  String[] @default([])
  assumptions   String[] @default([])
  rationale     String?
  status      WorkstreamStatus @default(PROPOSED)
  source      String          @default("RULE_BASED_SUGGESTION")
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
}

model Engagement {
  id                    String              @id @default(cuid())
  projectId             String
  professionalProfileId String
  createdById           String
  status                EngagementStatus    @default(INVITED)
  message               String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  professional          ProfessionalProfile @relation(fields: [professionalProfileId], references: [id])
  createdBy             User                @relation("EngagementCreator", fields: [createdById], references: [id])
  proposals             Proposal[]
  agreements            Agreement[]
  @@unique([projectId, professionalProfileId])
  @@index([professionalProfileId, status, updatedAt])
}

model Proposal {
  id                 String         @id @default(cuid())
  engagementId       String
  authorId           String
  previousProposalId String?
  version            Int            @default(1)
  amount             Int
  currency           String         @default("NGN")
  scope              String
  deliverables       String[]       @default([])
  assumptions        String[]       @default([])
  exclusions         String[]       @default([])
  revisionAllowance  Int            @default(1)
  usageRights        String?
  dependencies       String?
  expenses           String?
  deadline           DateTime?
  estimatedStartAt   DateTime?
  status             ProposalStatus @default(OPEN)
  expiresAt          DateTime?
  createdAt          DateTime       @default(now())
  engagement         Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  author             User           @relation(fields: [authorId], references: [id])
  previousProposal   Proposal?      @relation("ProposalThread", fields: [previousProposalId], references: [id])
  responses          Proposal[]     @relation("ProposalThread")
  @@index([engagementId, createdAt])
}

model Agreement {
  id           String          @id @default(cuid())
  engagementId String
  version      Int
  status       AgreementStatus @default(DRAFT)
  acceptedAt   DateTime?
  buyerAcceptedAt DateTime?
  talentAcceptedAt DateTime?
  buyerAcceptedById String?
  talentAcceptedById String?
  createdAt    DateTime        @default(now())
  engagement   Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  buyerAcceptedBy User?        @relation("AgreementBuyerAcceptance", fields: [buyerAcceptedById], references: [id])
  talentAcceptedBy User?       @relation("AgreementTalentAcceptance", fields: [talentAcceptedById], references: [id])
  terms        AgreementVersion?
  changeRequests ChangeRequest[]
  milestones   Milestone[]
  @@unique([engagementId, version])
}

model AgreementVersion {
  id          String    @id @default(cuid())
  agreementId String    @unique
  scope       String
  deliverables String[]
  amount      Int
  currency    String    @default("NGN")
  revisionTerms String?
  dueAt       DateTime?
  estimatedStartAt DateTime?
  revisionAllowance Int @default(1)
  usageRights String?
  assumptions String[] @default([])
  exclusions String[] @default([])
  acceptanceCriteria String[] @default([])
  reviewWindowDays Int @default(5)
  sourceProposalId String?
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model Milestone {
  id                 String               @id @default(cuid())
  projectId          String
  assignedProfileId  String?
  title              String
  description        String?
  deliverables       String[]             @default([])
  amount             Int                  @default(0)
  currency           String               @default("NGN")
  dueAt              DateTime?
  acceptanceCriteria String[]             @default([])
  reviewWindowDays   Int                  @default(5)
  revisionAllowance  Int                  @default(1)
  revisionCount      Int                  @default(0)
  status             MilestoneStatus      @default(NOT_STARTED)
  sourceAgreementId  String?             @unique
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedProfile    ProfessionalProfile? @relation(fields: [assignedProfileId], references: [id])
  sourceAgreement    Agreement?          @relation(fields: [sourceAgreementId], references: [id])
  compensationObligation CompensationObligation?
  submissions        Submission[]
  events             MilestoneEvent[]
  disputes           Dispute[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  @@index([projectId, status, dueAt])
}

model Submission {
  id            String    @id @default(cuid())
  milestoneId   String
  submittedById String
  note          String
  evidenceUrl   String?
  revision      Int       @default(0)
  createdAt     DateTime  @default(now())
  milestone     Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submittedBy   User      @relation(fields: [submittedById], references: [id])
}

model MilestoneEvent {
  id          String          @id @default(cuid())
  milestoneId String
  actorId     String
  fromStatus  MilestoneStatus?
  toStatus    MilestoneStatus
  note        String?
  createdAt   DateTime        @default(now())
  milestone   Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  actor       User            @relation(fields: [actorId], references: [id])
  @@index([milestoneId, createdAt])
}

model TalentShortlist {
  id                    String              @id @default(cuid())
  projectId             String
  professionalProfileId String
  createdById           String
  note                  String?
  createdAt             DateTime            @default(now())
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  professional          ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  createdBy             User                @relation("ShortlistCreator", fields: [createdById], references: [id])
  @@unique([projectId, professionalProfileId])
}

model TrustReview {
  id                    String                @id @default(cuid())
  professionalProfileId String?
  creatorProfileId      String?
  dimension             VerificationDimension
  status                TrustReviewStatus     @default(SUBMITTED)
  evidenceUrl           String?
  evidenceNote          String?
  reviewerId            String?
  reviewerNote          String?
  submittedAt           DateTime              @default(now())
  reviewedAt            DateTime?
  professional          ProfessionalProfile?  @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  creator               CreatorProfile?       @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  reviewer              User?                 @relation("TrustReviewer", fields: [reviewerId], references: [id])
  @@index([status, submittedAt])
}

model SkillsAssessment {
  id                    String              @id @default(cuid())
  professionalProfileId String
  title                 String
  category              String
  requiredSkills        String[]
  instructions          String
  rubric                Json?
  status                TrustReviewStatus   @default(NOT_STARTED)
  submittedEvidenceUrl  String?
  reviewerId            String?
  reviewerNote          String?
  score                 Int?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  createdAt             DateTime            @default(now())
  professional          ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  @@index([professionalProfileId, status])
}

model ProjectTask {
  id                String              @id @default(cuid())
  projectId         String
  assigneeProfileId String?
  title             String
  description       String?
  dueAt             DateTime?
  priority          TaskPriority        @default(NORMAL)
  status            TaskStatus          @default(TODO)
  dependencies      String[]            @default([])
  createdById       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee          ProfessionalProfile? @relation(fields: [assigneeProfileId], references: [id])
  comments          ProjectMessage[]
  @@index([projectId, status, dueAt])
}

model ProjectMessage {
  id        String           @id @default(cuid())
  projectId String
  taskId    String?
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime         @default(now())
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      ProjectTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  author    User             @relation(fields: [authorId], references: [id])
  parent    ProjectMessage?  @relation("MessageThread", fields: [parentId], references: [id])
  replies   ProjectMessage[] @relation("MessageThread")
  @@index([projectId, createdAt])
}

model ChangeRequest {
  id               String              @id @default(cuid())
  projectId        String
  agreementId      String
  createdById      String
  reason           String
  proposedScope    String
  proposedAmount   Int?
  proposedDeadline DateTime?
  status           ChangeRequestStatus @default(PENDING)
  respondedAt      DateTime?
  responseNote     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agreement        Agreement           @relation(fields: [agreementId], references: [id])
  createdBy        User                @relation("ChangeRequestAuthor", fields: [createdById], references: [id])
  @@index([projectId, status, createdAt])
}

model Dispute {
  id             String        @id @default(cuid())
  projectId      String
  milestoneId    String?
  openedById     String
  issueType      String
  description    String
  amountAffected Int?
  status         DisputeStatus @default(OPEN)
  resolution     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone      Milestone?    @relation(fields: [milestoneId], references: [id])
  openedBy       User          @relation("DisputeOpener", fields: [openedById], references: [id])
  @@index([projectId, status, createdAt])
}

model ProjectReview {
  id         String   @id @default(cuid())
  projectId  String
  reviewerId String
  decision   String
  note       String?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  @@index([projectId, createdAt])
}

model Campaign {
  id             String         @id @default(cuid())
  organisationId String?
  createdById    String
  title          String
  brief          String
  platforms      String[]       @default([])
  contentTypes   String[]       @default([])
  usageRights    String?
  landingUrl     String?
  currency       String         @default("NGN")
  status         CampaignStatus @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      User           @relation(fields: [createdById], references: [id])
  organisation   Organisation?  @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  creators       CampaignCreator[]
  @@index([status, createdAt])
}

model CampaignCreator {
  id                 String                @id @default(cuid())
  campaignId         String
  creatorId          String
  status             CampaignCreatorStatus @default(INVITED)
  fixedFee           Int                   @default(0)
  bonusRate          Int                   @default(0)
  bonusCap           Int?
  bonusTerms         String?
  contractTerms      String?
  contractAcceptedAt DateTime?
  referralCode       String                @unique @default(cuid())
  invitedAt          DateTime              @default(now())
  acceptedAt         DateTime?
  completedAt        DateTime?
  campaign           Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator            CreatorProfile        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  content            CampaignContent[]
  attributions       CampaignAttribution[]
  clicks             CampaignClick[]
  fixedObligation    CompensationObligation?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  @@unique([campaignId, creatorId])
  @@index([creatorId, status])
}

model CampaignContent {
  id                 String               @id @default(cuid())
  campaignCreatorId  String
  title              String
  submissionUrl      String?
  note               String
  status             CampaignContentStatus @default(SUBMITTED)
  reviewerId         String?
  reviewerNote       String?
  submittedAt        DateTime             @default(now())
  reviewedAt         DateTime?
  publishedUrl       String?
  publishedAt        DateTime?
  campaignCreator    CampaignCreator      @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  @@index([status, submittedAt])
}

model CampaignAttribution {
  id                String                  @id @default(cuid())
  campaignCreatorId String
  sourceEventId     String?                 @unique
  orderReference    String?
  amount            Int                     @default(0)
  currency          String                  @default("NGN")
  status            CampaignAttributionStatus @default(PENDING)
  occurredAt        DateTime                @default(now())
  reviewedAt        DateTime?
  reviewerId        String?
  reviewerNote      String?
  bonusAmount       Int                     @default(0)
  campaignCreator   CampaignCreator         @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  bonusObligation   CompensationObligation?
  @@index([campaignCreatorId, status, occurredAt])
}

model CampaignClick {
  id                String          @id @default(cuid())
  campaignCreatorId String
  sourceEventId     String          @unique
  occurredAt        DateTime        @default(now())
  campaignCreator   CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  @@index([campaignCreatorId, occurredAt])
}

model CompensationObligation {
  id            String             @id @default(cuid())
  reference     String             @unique
  projectId     String?
  milestoneId   String?            @unique
  campaignCreatorId String?        @unique
  attributionId String?            @unique
  recipientId   String?
  createdById   String?
  amount        Int
  currency      String
  status        CompensationStatus @default(PENDING)
  provider      String             @default("MOCK")
  simulated     Boolean            @default(true)
  paidAt        DateTime?
  failureReason String?
  createdAt     DateTime           @default(now())
  creator       User?              @relation("ObligationCreator", fields: [createdById], references: [id])
  recipient     User?              @relation("ObligationRecipient", fields: [recipientId], references: [id])
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone     Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  campaignCreator CampaignCreator? @relation(fields: [campaignCreatorId], references: [id])
  attribution   CampaignAttribution? @relation(fields: [attributionId], references: [id])
  ledgerEntries LedgerEntry[]
  @@index([status, createdAt])
}

model LedgerEntry {
  id            String                @id @default(cuid())
  obligationId  String
  kind          String
  amount        Int
  currency      String
  simulated     Boolean               @default(true)
  providerEventId String?
  obligation    CompensationObligation @relation(fields: [obligationId], references: [id])
  createdAt     DateTime              @default(now())
  @@unique([obligationId, kind, providerEventId])
  @@index([obligationId, createdAt])
}

model PaymentWebhookEvent {
  id             String   @id @default(cuid())
  provider       String
  eventId        String
  eventType      String
  payloadHash    String
  processedAt    DateTime?
  processingNote String?
  receivedAt     DateTime @default(now())
  @@unique([provider, eventId])
  @@index([processedAt, receivedAt])
}

model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String
  updatedAt   DateTime @updatedAt
  @@index([updatedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  purpose    String
  expires    DateTime
  @@index([identifier, purpose])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  @@index([expiresAt])
}
