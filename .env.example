DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kintovo?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional SMTP; without it, email verification and password recovery links are unavailable.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Kintovo <hello@example.com>"

# Optional OpenAI-compatible chat-completions endpoint. AI is only used for a brief when its owner opts in.
AI_PROVIDER="none"
AI_API_BASE_URL=""
AI_MODEL=""
AI_API_KEY=""

# Private object storage is not enabled in the first implementation slice.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# Live payment operations are intentionally unavailable; mock mode is labeled in-product.
PAYMENT_MODE="simulated"
PAYMENT_PROVIDER_NAME="UNCONFIGURED"
PAYMENT_WEBHOOK_SECRET=""
