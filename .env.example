DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kintovo?schema=public"
# Prisma CLI migrations use a direct URL; local development can use the same URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kintovo?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Users must verify their email before signing in.
REQUIRE_EMAIL_VERIFICATION="true"

# Optional Google OAuth. Google marks verified Google email addresses as verified.
# Create credentials at https://console.cloud.google.com/apis/credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional SMTP; without it, email verification and password recovery links are unavailable.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Kintovo <hello@example.com>"

# Optional Cloudflare Turnstile keys for a future bot-check integration.
# These are NOT currently read by the app; setting them alone does not protect forms.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Optional OpenAI-compatible chat-completions endpoint. AI is only used for a brief when its owner opts in.
AI_PROVIDER="none"
AI_API_BASE_URL=""
AI_MODEL=""
AI_API_KEY=""

# Private object storage is not enabled in the first implementation slice.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# Live payment operations are intentionally unavailable; mock mode is labeled in-product.
PAYMENT_MODE="simulated"
PAYMENT_PROVIDER_NAME="UNCONFIGURED"
PAYMENT_WEBHOOK_SECRET=""
# Keep at 0 until the fee policy is approved and persisted with each transaction.
PLATFORM_FEE_BPS="0"
PLATFORM_FEE_PAYER="BUSINESS"
