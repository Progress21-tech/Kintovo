DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kintovo?schema=public"
# Prisma CLI migrations use a direct URL; local development can use the same URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kintovo?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Email verification is optional; Google accounts are verified by Google.
REQUIRE_EMAIL_VERIFICATION="false"

# Optional Google OAuth. Google marks verified Google email addresses as verified.
# Create credentials at https://console.cloud.google.com/apis/credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional SMTP; without it, email verification and password recovery links are unavailable.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Kintovo <hello@example.com>"

# Optional Cloudflare Turnstile keys for a future bot-check integration.
# These are NOT currently read by the app; setting them alone does not protect forms.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# Optional AI planning. Gemini 3.8 Flash is the default free-tier provider; only the server-side key is required for this default.
# Google documents OpenAI-compatible chat completions at this endpoint. Free-tier limits apply.
AI_PROVIDER="gemini"
AI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
AI_MODEL="gemini-3.8-flash"
AI_API_KEY=""

# Private object storage is not enabled in the first implementation slice.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# Live payment operations are intentionally unavailable; mock mode is labeled in-product.
PAYMENT_MODE="simulated"
PAYMENT_PROVIDER_NAME="UNCONFIGURED"
PAYMENT_WEBHOOK_SECRET=""
# Keep at 0 until the fee policy is approved and persisted with each transaction.
PLATFORM_FEE_BPS="0"
PLATFORM_FEE_PAYER="BUSINESS"

# Paga Engine Sandbox. Keep disabled until the keys are configured locally and
# callback URLs below are reachable over HTTPS. The application rejects Live.
PAGA_ENVIRONMENT="sandbox"
PAGA_ENABLE_SANDBOX="false"
PAGA_SANDBOX_PUBLIC_KEY=""
PAGA_SANDBOX_SECRET_KEY=""
PAGA_SANDBOX_HASH_KEY=""
# Public HTTPS routes for Paga callbacks; configure these after deployment.
PAGA_ACCOUNT_CALLBACK_URL=""
PAGA_USD_COLLECTION_CALLBACK_URL=""
PAGA_PAYOUT_CALLBACK_URL=""
# Generate a separate random 32-byte key and base64-encode it. Required before
# collecting or sending beneficiary bank account numbers.
PAGA_BANK_ENCRYPTION_KEY=""
PAGA_LIVE_PUBLIC_KEY=""
PAGA_LIVE_SECRET_KEY=""
PAGA_LIVE_HASH_KEY=""
# Live values are placeholders only and are intentionally not read by the app.
